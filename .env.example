# Local only. Copy to `.env` and fill in values.
# Loaded solely when ASPNETCORE_ENVIRONMENT=Development.
# Production (droplet) should set these as OS / systemd env vars — do not deploy a .env file.

JWT_ISSUER=http://localhost:5001
JWT_AUDIENCE=http://localhost:3000
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
JWT_SIGNING_KEY=replace-with-at-least-64-character-secret-key-for-hmac-sha512
# Transactional mail (Brevo SMTP). From must be a verified sender in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SEED_OWNER_PASSWORD=
SEED_DELETEDUSER_PASSWORD=
POSTGRES_PASSWORD=
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=foodiestopia;Username=postgres;Password=
