# Copy to .env on the droplet (never commit the real file).
# JWT is HMAC from these env vars — the Nuxt client never gets JWT_SIGNING_KEY.

JWT_ISSUER=https://api.foodiestopia.com
JWT_AUDIENCE=https://foodiestopia.com
BASE_URL=https://api.foodiestopia.com
# Email links. Use http://localhost:3000 while the Nuxt app is local;
# switch to https://foodiestopia.com when the site is live.
FRONTEND_URL=http://localhost:3000
JWT_SIGNING_KEY=
GMAIL_EMAIL=
GMAIL_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_DELETEDUSER_PASSWORD=
POSTGRES_PASSWORD=
